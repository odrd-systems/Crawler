# -----------------------------------------------------------------------
# Crawler — local configuration example
# -----------------------------------------------------------------------
# Copy this file to .env and edit as needed.
#
# macOS / Linux:  export $(cat .env | xargs)
# Windows CMD:    for each line below run  set KEY=VALUE
# -----------------------------------------------------------------------

# Redis URL (optional).
# Leave commented out (or empty) to use the built-in in-memory store,
# which requires no extra software and is perfect for local development.
# Uncomment to use Redis instead (e.g. for persistent state or production):
# REDIS_URL=redis://localhost:6379

# Maximum number of pages scraped concurrently (default: 5).
# MAX_CONCURRENCY=5
